{
  "name": "chocks",
  "version": "0.1.0",
  "type": "module",
  "description": "Track planned and existing features as a tree, stored in your repo",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "chocks": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --experimental-strip-types --watch src/cli.ts --no-open --port 4321",
    "routes": "tsr generate",
    "build": "pnpm routes && pnpm build:ui && pnpm build:server",
    "build:ui": "vite build",
    "build:server": "tsdown",
    "start": "node dist/cli.mjs",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm routes && tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "chokidar": "^5.0.0",
    "hono": "^4.12.33",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/router-cli": "^1.167.21",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fractional-indexing": "^4.0.0",
    "lucide-react": "^1.28.0",
    "next-themes": "^0.4.6",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
